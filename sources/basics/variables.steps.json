{
  "title": "变量与赋值",
  "description": "Python 中变量的创建、赋值和类型变化",
  "steps": [
    { "line": 3, "action": "assign", "vars": { "name": { "value": "\"Alice\"", "type": "str" } }, "note": "创建字符串变量 name" },
    { "line": 4, "action": "assign", "vars": { "age": { "value": "25", "type": "int" } }, "note": "创建整数变量 age" },
    { "line": 5, "action": "assign", "vars": { "height": { "value": "1.68", "type": "float" } }, "note": "创建浮点数变量 height" },
    { "line": 6, "action": "assign", "vars": { "is_student": { "value": "True", "type": "bool" } }, "note": "创建布尔变量 is_student" },
    { "line": 9, "action": "assign", "vars": { "age": { "value": "26", "type": "int", "changed": true } }, "note": "age 加 1，值变为 26" },
    { "line": 10, "action": "assign", "vars": { "age": { "value": "\"twenty-six\"", "type": "str", "changed": true } }, "note": "age 被重新赋值为字符串！类型从 int 变为 str" },
    { "line": 13, "action": "assign", "vars": { "x": { "value": "1", "type": "int" }, "y": { "value": "2", "type": "int" }, "z": { "value": "3", "type": "int" } }, "note": "多重赋值，一行创建三个变量" },
    { "line": 16, "action": "swap", "vars": { "x": { "value": "2", "type": "int", "changed": true }, "y": { "value": "1", "type": "int", "changed": true } }, "note": "Python 式交换，x 和 y 的值互换" },
    { "line": 18, "action": "output", "output": "Alice twenty-six 1.68", "note": "打印变量值" }
  ]
}
